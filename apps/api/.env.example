PORT=4000
WEB_ORIGIN=http://localhost:3000
SITE_URL=http://localhost:3000
LOST_FOUND_OFFICE=CBEA Faculty Office

# Use the replacement project's URL and API keys.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Server only. Never use this in NEXT_PUBLIC_* variables.
SUPABASE_SECRET_KEY=YOUR_SECRET_KEY

# Copy the exact pooled and direct URIs from Supabase Dashboard > Connect.
# URL-encode special characters in the database password.
# The deployed API uses DATABASE_URL. Migrations and seed scripts use DIRECT_URL.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@POOLER_HOST:6543/postgres
DIRECT_URL=postgresql://postgres:YOUR_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres

PORT=4000
WEB_ORIGIN=http://localhost:3000
SITE_URL=http://localhost:3000

# Use the replacement project's URL and API keys.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Server only. Never use this in NEXT_PUBLIC_* variables.
SUPABASE_SECRET_KEY=YOUR_SECRET_KEY

# Copy the exact session pooler URI from Supabase Dashboard > Connect.
# URL-encode special characters in the database password.
# The API and database tools prefer DIRECT_URL when set.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@POOLER_HOST:5432/postgres
DIRECT_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@POOLER_HOST:5432/postgres

generator client {
  provider = "prisma-client"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  STUDENT
  FACULTY
  STAFF
  ADMIN
}

enum AccountStatus {
  PENDING
  ACTIVE
  DEACTIVATED
}

enum ReportType {
  LOST
  FOUND
}

enum ReportStatus {
  DRAFT
  OPEN
  MATCHED
  CLAIM_PENDING
  CLAIMED
  ARCHIVED
}

enum MatchStatus {
  SUGGESTED
  DISMISSED
  CONFIRMED
}

enum ClaimStatus {
  PENDING
  NEEDS_INFORMATION
  APPROVED
  REJECTED
  RELEASED
}

model MasterPerson {
  id           String   @id @default(uuid()) @db.Uuid
  schoolId     String   @unique @map("school_id")
  fullName     String   @map("full_name")
  email        String?
  role         UserRole
  course       String?
  yearLevel    String?  @map("year_level")
  section      String?
  position     String?
  department   String?
  isActive     Boolean  @default(true) @map("is_active")
  importBatch  String?  @map("import_batch")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  user         User?

  @@map("master_people")
}

model User {
  id             String        @id @db.Uuid
  masterPersonId String        @unique @map("master_person_id") @db.Uuid
  masterPerson   MasterPerson  @relation(fields: [masterPersonId], references: [id])
  role           UserRole
  status         AccountStatus @default(PENDING)
  displayName    String        @map("display_name")
  email          String        @unique
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  reports        ItemReport[]
  claims         Claim[]       @relation("Claimant")
  reviewedClaims Claim[]       @relation("ClaimReviewer")
  releases       ReleaseTransaction[]
  notifications  Notification[]
  auditEntries   AuditLog[]

  @@index([role, status])
  @@map("users")
}

model Category {
  id        String       @id @default(uuid()) @db.Uuid
  name      String       @unique
  isActive  Boolean      @default(true) @map("is_active")
  reports   ItemReport[]
  createdAt DateTime     @default(now()) @map("created_at")

  @@map("categories")
}

model Location {
  id        String       @id @default(uuid()) @db.Uuid
  name      String       @unique
  isActive  Boolean      @default(true) @map("is_active")
  reports   ItemReport[]
  createdAt DateTime     @default(now()) @map("created_at")

  @@map("locations")
}

model ItemReport {
  id                         String       @id @default(uuid()) @db.Uuid
  reporterId                 String       @map("reporter_id") @db.Uuid
  reporter                   User         @relation(fields: [reporterId], references: [id])
  categoryId                 String       @map("category_id") @db.Uuid
  category                   Category     @relation(fields: [categoryId], references: [id])
  locationId                 String       @map("location_id") @db.Uuid
  location                   Location     @relation(fields: [locationId], references: [id])
  type                       ReportType
  status                     ReportStatus @default(OPEN)
  title                      String
  color                      String
  publicDescription          String?      @map("public_description")
  privateVerificationDetails String?      @map("private_verification_details")
  occurredAt                 DateTime     @map("occurred_at")
  createdAt                  DateTime     @default(now()) @map("created_at")
  updatedAt                  DateTime     @updatedAt @map("updated_at")
  archivedAt                 DateTime?    @map("archived_at")
  images                     ItemImage[]
  lostMatches                ItemMatch[]  @relation("LostReport")
  foundMatches               ItemMatch[]  @relation("FoundReport")
  claims                     Claim[]

  @@index([type, status, occurredAt])
  @@index([categoryId, color])
  @@map("item_reports")
}

model ItemImage {
  id         String     @id @default(uuid()) @db.Uuid
  reportId   String     @map("report_id") @db.Uuid
  report     ItemReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  storageKey String     @map("storage_key")
  mimeType   String     @map("mime_type")
  sizeBytes  Int        @map("size_bytes")
  isPrimary  Boolean    @default(false) @map("is_primary")
  createdAt  DateTime   @default(now()) @map("created_at")

  @@map("item_images")
}

model ItemMatch {
  id                    String      @id @default(uuid()) @db.Uuid
  lostReportId          String      @map("lost_report_id") @db.Uuid
  lostReport            ItemReport  @relation("LostReport", fields: [lostReportId], references: [id])
  foundReportId         String      @map("found_report_id") @db.Uuid
  foundReport           ItemReport  @relation("FoundReport", fields: [foundReportId], references: [id])
  score                 Decimal     @db.Decimal(5, 2)
  matchedReasons        Json        @map("matched_reasons")
  conflictingAttributes Json        @map("conflicting_attributes")
  status                MatchStatus @default(SUGGESTED)
  createdAt             DateTime    @default(now()) @map("created_at")
  updatedAt             DateTime    @updatedAt @map("updated_at")

  @@unique([lostReportId, foundReportId])
  @@index([status, score])
  @@map("item_matches")
}

model Claim {
  id               String      @id @default(uuid()) @db.Uuid
  reportId         String      @map("report_id") @db.Uuid
  report           ItemReport  @relation(fields: [reportId], references: [id])
  claimantId       String      @map("claimant_id") @db.Uuid
  claimant         User        @relation("Claimant", fields: [claimantId], references: [id])
  status           ClaimStatus @default(PENDING)
  ownershipAnswers Json        @map("ownership_answers")
  reviewNotes      String?     @map("review_notes")
  reviewedById     String?     @map("reviewed_by_id") @db.Uuid
  reviewedBy       User?       @relation("ClaimReviewer", fields: [reviewedById], references: [id])
  reviewedAt       DateTime?   @map("reviewed_at")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")
  proofs           ClaimProof[]
  release          ReleaseTransaction?

  @@index([status, createdAt])
  @@map("claims")
}

model ClaimProof {
  id         String   @id @default(uuid()) @db.Uuid
  claimId    String   @map("claim_id") @db.Uuid
  claim      Claim    @relation(fields: [claimId], references: [id], onDelete: Cascade)
  storageKey String   @map("storage_key")
  mimeType   String   @map("mime_type")
  sizeBytes  Int      @map("size_bytes")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("claim_proofs")
}

model ReleaseTransaction {
  id             String   @id @default(uuid()) @db.Uuid
  claimId        String   @unique @map("claim_id") @db.Uuid
  claim          Claim    @relation(fields: [claimId], references: [id])
  releasedById   String   @map("released_by_id") @db.Uuid
  releasedBy     User     @relation(fields: [releasedById], references: [id])
  identityMethod String   @map("identity_method")
  receiptNumber  String?  @unique @map("receipt_number")
  notes          String?
  releasedAt     DateTime @default(now()) @map("released_at")

  @@map("release_transactions")
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  data      Json?
  readAt    DateTime? @map("read_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model Announcement {
  id          String   @id @default(uuid()) @db.Uuid
  title       String
  body        String
  audience    UserRole?
  publishedAt DateTime? @map("published_at")
  expiresAt   DateTime? @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("announcements")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  before     Json?
  after      Json?
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

